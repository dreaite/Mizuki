---
import { getCollection, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import { PageHeader } from "@components/features/page-header";
import Markdown from "@components/misc/Markdown.astro";

import I18nKey from "../i18n/i18nKey";
import { getCurrentLocaleLang, setCurrentLocaleContext } from "../i18n/locale";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getPostVariantInfo } from "../utils/post-variant-utils";

setCurrentLocaleContext(Astro.props.localePath);
const currentLocaleLang = getCurrentLocaleLang();
const aboutPost = (await getCollection("spec")).find((entry) => {
	const variant = getPostVariantInfo(entry);
	if (variant.canonicalId !== "about") return false;
	return currentLocaleLang === "zh_CN"
		? !variant.variantLang
		: variant.variantLang === currentLocaleLang;
});
const renderedAbout = aboutPost ? await render(aboutPost) : undefined;
const AboutContent = renderedAbout?.Content;
const title = i18n(I18nKey.about);
---

<MainGridLayout title={title}>
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<PageHeader title={title} />

			<!-- 从MD文件读取的内容 -->
			<Markdown class="mt-2">
				{
					AboutContent ? (
						<AboutContent />
					) : (
						<p class="text-center py-16 text-black/40 dark:text-white/40">
							{i18n(I18nKey.noData)}
						</p>
					)
				}
			</Markdown>
		</div>
	</div>

	{
		AboutContent && (
			<div class="mt-4">
				<Comment path="/about/" />
			</div>
		)
	}
</MainGridLayout>
