---
import type { AnimeStatus } from "../../../utils/anime-data";

interface Props {
	filterAllLabel: string;
	statusWatchingLabel: string;
	statusPlannedLabel: string;
	statusCompletedLabel: string;
	statusOnHoldLabel?: string;
	statusDroppedLabel?: string;
	showExtendedFilters: boolean;
	statusOrder?: AnimeStatus[];
}

const {
	filterAllLabel,
	statusWatchingLabel,
	statusPlannedLabel,
	statusCompletedLabel,
	statusOnHoldLabel,
	statusDroppedLabel,
	showExtendedFilters,
	statusOrder = ["watching", "planned", "completed", "onhold", "dropped"],
} = Astro.props;

const statusLabels: Record<AnimeStatus, string | undefined> = {
	watching: statusWatchingLabel,
	planned: statusPlannedLabel,
	completed: statusCompletedLabel,
	onhold: statusOnHoldLabel,
	dropped: statusDroppedLabel,
};

const visibleStatuses = statusOrder.filter(
	(status) =>
		showExtendedFilters || (status !== "onhold" && status !== "dropped"),
);
---

<div class="anime-filter-container flex flex-wrap gap-2">
	<button class="anime-filter-tag anime-active" data-status="all"
		>{filterAllLabel}</button
	>
	{
		visibleStatuses.map((status) => (
			<button class="anime-filter-tag" data-status={status}>
				{statusLabels[status]}
			</button>
		))
	}
</div>
